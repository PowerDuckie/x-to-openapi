{
  "name": "@powerduck/x-to-openapi",
  "version": "0.2.0",
  "type": "module",
  "description": "Extensible production-grade X-to-OpenAPI 3.2 conversion framework. Convert curl commands and Postman collections to OpenAPI 3.2 documents.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "demo": "tsx examples/basic.ts",
    "check": "tsc --noEmit && vitest run"
  },
  "keywords": [
    "openapi",
    "swagger",
    "curl",
    "postman",
    "converter",
    "api",
    "rest",
    "typescript",
    "esm",
    "cjs"
  ],
  "license": "MIT",
  "author": "Powerduck limited",
  "repository": {
    "type": "git",
    "url": "https://github.com/PowerDuckie/x-to-openapi.git"
  },
  "bugs": {
    "url": "https://github.com/PowerDuckie/x-to-openapi/issues"
  },
  "homepage": "https://github.com/PowerDuckie/x-to-openapi#readme",
  "dependencies": {
    "@powerduck/openapi-parser": "^0.3.3",
    "curlconverter": "^4.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.2.7",
    "terser": "^5.51.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.1.0"
  }
}
